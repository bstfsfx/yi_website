# External platform .ics calendar feeds, one per online room.
# Get these from each platform's calendar export page, e.g.:
#   Airbnb  → 近期行程 → 日曆匯出 → 複製 iCal 連結
#   Booking.com → Rates & Availability → Sync calendars → Export
#
# When a URL is present it is fetched + parsed by /api/sync-calendar.
# When absent, the room falls back to a generated demo feed (clearly labelled
# "示範" in the booking grid).
ICS_DOUBLE_URL=
ICS_QUAD_URL=
